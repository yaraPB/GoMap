{
  "name": "gomap-api",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "test": "node --import tsx --test test/*.test.ts",
    "check": "tsc --noEmit -p tsconfig.json",
    "geo:import": "tsx src/scripts/import-geo.ts",
    "graph:check": "tsx src/scripts/graph-check.ts",
    "seed": "tsx src/scripts/seed.ts"
  },
  "dependencies": {
    "@mapbox/vector-tile": "^3.0.0",
    "@turf/turf": "^7.4.0",
    "express": "^5.1.0",
    "fuse.js": "^7.5.0",
    "mongodb-memory-server": "^11.3.0",
    "mongoose": "^9.12.1",
    "multer": "^2.5.0",
    "pbf": "^5.1.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
