# The assistant model, server-side only. Without any key the assistant still answers places,
# people, procedures, events and your admin rules locally; only open questions need a model.
# ASSISTANT_PROVIDER: auto (Claude if ANTHROPIC_API_KEY is set, else Gemini) | claude | gemini
ASSISTANT_PROVIDER=auto
# Claude (Anthropic): https://platform.claude.com → API keys
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Gemini, server-side only. Also the voice fallback when Soniox is not set. Without it the assistant still answers places, people and
# procedures locally; open questions and Expo Go voice transcription need it.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.8-flash
# Optional: Soniox handles recorded speech when configured; otherwise Gemini is used.
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v6
# Live words while speaking (dev build): the phone gets a 5-minute key from /api/assistant/stt-session
SONIOX_RT_MODEL=stt-rt-v6
PORT=4000

# MongoDB for the map data (places, entrances, walkways, report pins).
# Leave empty to run an in-memory MongoDB that seeds itself on every start.
# Atlas free tier: mongodb+srv://USER:PASS@cluster.mongodb.net/gomap
MONGODB_URI=

# SQLite file for people, presence, procedures, crowding and the assistant log.
# GOMAP_DB=./data/gomap.sqlite

# Admin dashboard token (works next to admin accounts, for setup and scripts)
ADMIN_TOKEN=change-me

# Accounts are email + password (see setup_guide.md section 8)
# Long random string: signs GoMap sessions (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
SESSION_SECRET=
# Who becomes a developer when they create their account (opens the dev dashboard), comma-separated
DEV_EMAILS=
# Optional: token to open the dev dashboard without an account (setup, scripts)
DEV_TOKEN=

# Only for `npm run geo:import` (re-import paths, roads and buildings from Mapbox).
# Falls back to EXPO_PUBLIC_MAPBOX_TOKEN in mobile/.env.local.
# MAPBOX_TOKEN=pk.your-public-mapbox-token
