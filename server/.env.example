# Gemini, server-side only. Without it the assistant still answers places, people and
# procedures locally; open questions and Expo Go voice transcription need it.
GEMINI_API_KEY=replace-with-your-google-ai-studio-key
GEMINI_MODEL=gemini-3.5-flash-lite
# Optional: Soniox handles recorded speech when configured; otherwise Gemini is used.
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v6
PORT=4000

# MongoDB for the map data (places, entrances, walkways, report pins).
# Leave empty to run an in-memory MongoDB that seeds itself on every start.
# Atlas free tier: mongodb+srv://USER:PASS@cluster.mongodb.net/gomap
MONGODB_URI=

# SQLite file for people, presence, procedures, crowding and the assistant log.
# GOMAP_DB=./data/gomap.sqlite

# Admin dashboard token. TODO: replace with GoCampus SSO
ADMIN_TOKEN=change-me

# Only for `npm run geo:import` (re-import paths, roads and buildings from Mapbox).
# Falls back to EXPO_PUBLIC_MAPBOX_TOKEN in mobile/.env.local.
# MAPBOX_TOKEN=pk.your-public-mapbox-token
