EXPO_PUBLIC_API_URL=http://YOUR_COMPUTER_WIFI_IP:4000
EXPO_PUBLIC_MAPBOX_TOKEN=pk.your-public-mapbox-token
EXPO_PUBLIC_SPEECH_ENGINE=recorded

# Optional: Google Map Tiles API key (Photorealistic 3D Tiles) for the "Campus in 3D" view.
# Without it the view is simply not offered. Keep the real key in .env.local.
EXPO_PUBLIC_GOOGLE_MAP_TILES_KEY=
