{
  "expo": {
    "name": "GoMap",
    "slug": "gomap",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      ["expo-camera", { "cameraPermission": "Allow GoMap to show the camera guide and capture a photo.", "recordAudioAndroid": false }],
      ["expo-location", { "locationWhenInUsePermission": "Allow GoMap to estimate the direction to a selected campus place." }],
      "expo-status-bar"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "usesCleartextTraffic": true,
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
